rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /locations/{locationId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /locationSuggestions/{suggestionId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.city is string
        && request.resource.data.status == "pending";
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if owns(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.locationId is string;
      allow delete: if false;
    }

    match /playmates/{playmateId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /pushTokens/{tokenId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.provider == "fcm"
        && request.resource.data.token is string
        && request.resource.data.locationId is string;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /pushSubscriptions/{subscriptionId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.endpoint is string
        && request.resource.data.keys.p256dh is string
        && request.resource.data.keys.auth is string
        && request.resource.data.locationId is string;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /availability/{availabilityId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.locationId is string
        && request.resource.data.type in ["readyNow", "laterToday", "tomorrow", "weekend"];
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /games/{gameId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      allow create, delete: if false;
    }
  }
}
